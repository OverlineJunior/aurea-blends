---
import { site } from '../data/site';
import { categories } from '../data/categories';
import { buildWhatsAppLink, GENERAL_MESSAGE } from '../lib/whatsapp';
import { whatsappIcon } from '../lib/icons';
import Badge from './Badge.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="hero-eyebrow">Blends artesanais · {site.city}</p>
      <h1 class="hero-title" id="hero-title">{site.slogan}</h1>
      <p class="hero-sub">
        Blends artesanais de chá, café e capuccino, e pirulitos para drinks — criados com
        propósito e delicadeza em Foz do Iguaçu.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary btn-lg" href="#blends">Ver blends</a>
        <a
          class="btn btn-secondary btn-lg"
          href={buildWhatsAppLink(GENERAL_MESSAGE)}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Fragment set:html={whatsappIcon} />
          Falar no WhatsApp
        </a>
      </div>
      <ul class="hero-badges" aria-label="Diferenciais da Auréa Blends">
        {
          site.badges.map((badge) => (
            <li>
              <Badge label={badge} />
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero-art" aria-hidden="true">
      <div class="art-blob">
        <span class="art-emoji">🌹</span>
        <span class="art-caption">blends em forma de rosas</span>
      </div>
      {
        categories.map((category, index) => (
          <span class={`art-chip art-chip-${index % 4}`}>
            <span>{category.emoji}</span>
            {category.label}
          </span>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(4rem, 10vw, 7rem) clamp(4.5rem, 9vw, 6.5rem);
    scroll-margin-top: 4.5rem;
  }

  /* manchas suaves de fundo, em tons da paleta */
  .hero::before,
  .hero::after {
    content: '';
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.6;
  }

  .hero::before {
    width: 34rem;
    height: 34rem;
    top: -14rem;
    right: -12rem;
    background: var(--color-surface-alt);
  }

  .hero::after {
    width: 26rem;
    height: 26rem;
    bottom: -12rem;
    left: -10rem;
    background: var(--color-surface);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2.5rem, 6vw, 4.5rem);
    align-items: center;
  }

  .hero-eyebrow {
    margin-bottom: 1.1rem;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .hero-title {
    margin-bottom: 1.25rem;
    font-size: clamp(3.2rem, 8vw, 5.2rem);
  }

  .hero-sub {
    max-width: 34rem;
    margin-bottom: 2rem;
    font-size: 1.15rem;
    color: var(--color-text-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .hero-art {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 24rem;
  }

  .art-blob {
    display: grid;
    gap: 0.5rem;
    place-items: center;
    width: min(20rem, 85%);
    aspect-ratio: 1;
    padding: 2rem;
    text-align: center;
    background: linear-gradient(140deg, var(--color-surface) 0%, var(--color-surface-alt) 55%, var(--color-border) 100%);
    border-radius: 38% 62% 55% 45% / 45% 40% 60% 55%;
    box-shadow: var(--shadow-lift);
  }

  .art-emoji {
    font-size: clamp(5rem, 10vw, 7rem);
    line-height: 1;
  }

  .art-caption {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--color-primary);
  }

  .art-chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-soft);
    font-size: 0.95rem;
    font-weight: 800;
    animation: chip-float 7s ease-in-out infinite;
  }

  .art-chip-0 { top: 3%; left: 0; }
  .art-chip-1 { top: 14%; right: -2%; animation-delay: -2.2s; }
  .art-chip-2 { bottom: 12%; left: 2%; animation-delay: -4.1s; }
  .art-chip-3 { bottom: 0; right: 4%; animation-delay: -5.6s; }

  @keyframes chip-float {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-10px);
    }
  }

  @media (max-width: 62rem) {
    .hero-inner {
      grid-template-columns: 1fr;
    }

    .hero-art {
      min-height: 0;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.7rem;
      margin-top: 1rem;
    }

    .art-blob {
      order: -1;
      width: 13rem;
    }

    .art-chip {
      position: static;
      animation: none;
    }
  }
</style>