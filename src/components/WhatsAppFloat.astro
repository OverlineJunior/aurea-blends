---
import { buildWhatsAppLink, GENERAL_MESSAGE } from '../lib/whatsapp';
import { whatsappIcon } from '../lib/icons';
---

<a
  class="wa-float"
  href={buildWhatsAppLink(GENERAL_MESSAGE)}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Conversar com a Auréa Blends no WhatsApp"
>
  <Fragment set:html={whatsappIcon} />
</a>

<style>
  .wa-float {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 60;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    background: var(--color-surface);
    color: var(--color-primary);
    border: 1px solid var(--color-border);
    border-radius: 50%;
    box-shadow: var(--shadow-lift);
    transition: transform 0.2s ease;
  }

  .wa-float:hover {
    transform: scale(1.08);
  }

  .wa-float :global(svg) {
    width: 1.7rem;
    height: 1.7rem;
  }
</style>