---
import { categories } from '../data/categories';
import { products } from '../data/products';
import ProductCard from './ProductCard.astro';

// só aparece no filtro a categoria que tem produto — categoria sem produto some sozinha
const activeCategories = categories.filter((category) =>
  products.some((product) => product.categoryId === category.id),
);

// destaques primeiro, mantendo a ordem original dentro de cada grupo
const sortedProducts = [...products].sort(
  (a, b) => Number(b.featured ?? false) - Number(a.featured ?? false),
);

// ── Filtro CSS-only (radio + :checked) ──────────────────────
// Os seletores são GERADOS a partir das categorias do data:
// nenhuma id de categoria é escrita à mão neste componente.
const filterIds = ['all', ...activeCategories.map((category) => category.id)];

const checkedSelectors = filterIds
  .map((id) => `#filter-${id}:checked ~ .filter-bar label[for="filter-${id}"]`)
  .join(',\n');

const focusSelectors = filterIds
  .map((id) => `#filter-${id}:focus-visible ~ .filter-bar label[for="filter-${id}"]`)
  .join(',\n');

const hideRules = activeCategories
  .map(
    (category) =>
      `#filter-${category.id}:checked ~ .products-grid .product-card:not([data-category="${category.id}"]) { display: none; }`,
  )
  .join('\n');

const filterStateCss = `
${hideRules}

${checkedSelectors} {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: var(--color-on-primary);
}

${focusSelectors} {
  outline: 3px solid var(--color-accent);
  outline-offset: 2px;
}
`;
---

<section id="blends" class="section section-alt">
  <div class="container">
    <div class="section-head">
      <p class="section-eyebrow">Nossos blends</p>
      <h2 class="section-title">Escolha o seu momento</h2>
      <p class="section-sub">
        Cápsulas artesanais de chá, café e capuccino, e pirulitos para drinks — tudo zero açúcar
        e feito à mão. Toque em uma categoria para filtrar 💛
      </p>
    </div>

    <div class="filter-area">
      <input type="radio" name="categoria-produto" id="filter-all" class="sr-only" checked />
      {
        activeCategories.map((category) => (
          <input type="radio" name="categoria-produto" id={`filter-${category.id}`} class="sr-only" />
        ))
      }

      <div class="filter-bar" role="group" aria-label="Filtrar blends por categoria">
        <label class="filter-btn" for="filter-all">✨ Todos</label>
        {
          activeCategories.map((category) => (
            <label class="filter-btn" for={`filter-${category.id}`}>
              {category.emoji} {category.label}
            </label>
          ))
        }
      </div>

      <div class="products-grid">
        {sortedProducts.map((product) => <ProductCard product={product} />)}
      </div>
    </div>
  </div>

  <style is:inline set:html={filterStateCss} />
  <style>
    .filter-bar {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.6rem;
      margin-bottom: 2.25rem;
    }

    .filter-btn {
      padding: 0.5rem 1.15rem;
      border: 1.5px solid var(--color-border);
      border-radius: var(--radius-full);
      background: var(--color-surface);
      color: var(--color-text);
      font-size: 0.95rem;
      font-weight: 800;
      cursor: pointer;
      transition:
        background-color 0.18s ease,
        border-color 0.18s ease,
        color 0.18s ease,
        transform 0.18s ease;
    }

    .filter-btn:hover {
      border-color: var(--color-primary);
      color: var(--color-primary);
      transform: translateY(-2px);
    }

    .products-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(17.5rem, 1fr));
      gap: 1.5rem;
    }
  </style>
</section>