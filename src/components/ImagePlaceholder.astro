---
interface Props {
  name: string;
  emoji?: string;
}

const { name, emoji = '🌿' } = Astro.props;
---

<figure class="img-placeholder" aria-hidden="true">
  <span class="ph-emoji">{emoji}</span>
  <span class="ph-name">{name}</span>
  <span class="ph-note">foto em breve ✨</span>
</figure>

<style>
  .img-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    aspect-ratio: 4 / 3;
    padding: 1.5rem;
    text-align: center;
    background: linear-gradient(
      140deg,
      var(--color-surface) 0%,
      var(--color-surface-alt) 55%,
      var(--color-border) 100%
    );
  }

  .ph-emoji {
    font-size: clamp(3.5rem, 8vw, 5rem);
    line-height: 1;
  }

  .ph-name {
    font-family: var(--font-display);
    font-size: 1.6rem;
    line-height: 1.15;
    color: var(--color-text);
  }

  .ph-note {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
  }
</style>